{
    "project": {
        "name": "yazlab2-timeseries-automata",
        "version": "0.1.0"
    },
    "device": {
        "type": "auto"
    },
    "random_seeds": [42, 123, 2026, 7, 999],
    "training": {
        "max_epochs": 50,
        "batch_size": 32,
        "early_stopping_patience": 5,
        "early_stopping_min_delta": 0.0,
        "learning_rate": 0.001,
        "optimizer": "adam",
        "loss_function": "bce_with_logits",
        "class_imbalance_strategy": "train_pos_weight",
        "classification_threshold": 0.5,
        "num_workers": 0,
        "use_amp": true
    },
    
    "models": {
        "enabled_models": ["lstm", "gru", "cnn1d", "automata"],
        "architectures": {
            "lstm": {
                "hidden_size": 64,
                "num_layers": 1,
                "dropout": 0.2,
                "bidirectional": false
            },
            "gru": {
                "hidden_size": 64,
                "num_layers": 1,
                "dropout": 0.2,
                "bidirectional": false
            },
            "cnn1d": {
                "conv_channels": [32, 64],
                "kernel_size": 3,
                "dropout": 0.2
            }
        }
    },

    "preprocessing": {
        "normalization": "standard_scaler",
        "automata_dimension_reduction": "pca",
        "automata_n_components": 1
    },
    "windowing": {
        "sequence_length": 32,
        "label_strategy": "last_time_step"
    },
    "automata": {
        "context_length": 32,
        "default_window_size": 4,
        "default_alphabet_size": 3,
        "window_size_values": [3, 4, 5, 6],
        "alphabet_size_values": [3, 4, 5, 6],
        "state_construction": "sliding_context_paa_sax_word",
        "state_label_strategy": "last_time_step",
        "transition_target_strategy": "destination_state_label",
        "sax_normalization": "train_zscore",
        "sax_breakpoint_strategy": "gaussian",
        "learning_strategy": "normal_train_runs",
        "score_strategy": "mean_negative_log_probability",
        "threshold_strategy": "validation_best_f1",
        "threshold_tie_break": "higher_precision_then_higher_threshold",
        "unseen_mapping_strategy": "levenshtein_nearest_state",
        "unseen_tie_break": "alphabetical_state",
        "confidence_strategy": "relative_threshold_margin",
        "confidence_is_probability": false,
        "smoothing": 1e-8
    },
    "experiments": {
        "scenarios": ["original", "gaussian_noise", "unseen"],
        "main_metric": "f1_score",
        "metrics": ["accuracy", "precision", "recall", "f1_score"],
        "robustness": {
            "gaussian_noise": {
                "levels": [0.01, 0.05, 0.10],
                "apply_to": "test_only",
                "scale_reference": "training_feature_standard_deviation",
                "retrain_model": false,
                "noise_seed": 2026
            },
            "unseen_analysis": {
                "applies_to": ["automata"],
                "report_seen_vs_unseen": true
            }
        },
        "parameter_analysis": {
            "automata": {
                "context_length_fixed": 32,
                "window_size_values": [3, 4, 5, 6],
                "alphabet_size_values": [3, 4, 5, 6],
                "primary_metric": "f1_score"
            }
        }
    },
    "execution": {
        "full_run_requires_confirmation": true,
        "full_run_confirmation_phrase": "tamamla",
        "benchmark_before_full_run": true,
        "benchmark_requires_confirmation": true,
        "benchmark_confirmation_phrase": "benchmark",
        "benchmark_task_ids": [
            "deep_learning_robustness__BATADAL__gru__seed42"
        ],
        "skab_fold_count": 5,
        "reuse_default_automata_parameter_result": true,
        "default_automata_parameter_setting": {
            "window_size": 4,
            "alphabet_size": 3
        },
    "result_export_formats": ["csv", "json"],
        "resume_completed_tasks": true,
        "checkpoint_results_after_each_task": true,
        "export_artifacts": {
            "save_sample_predictions": true,
            "save_automata_explanations": true,
            "save_automata_transition_tables": true
        }
    },
    "paths": {
        "log_dir": "experiments/logs",
        "metrics_dir": "experiments/metrics",
        "models_dir": "experiments/models",
        "predictions_dir": "experiments/predictions",
        "figures_dir": "reports/figures",
        "tables_dir": "reports/tables"
    },
    "evaluation": {
        "classification_metrics": [
            "accuracy",
            "precision",
            "recall",
            "f1_score",
            "roc_auc",
            "average_precision"
        ],
        "deep_learning_probability_threshold": 0.5,
        "score_positive_direction": "higher_score_is_anomaly",
        "zero_division": 0
    },
    "visualization": {
        "figure_format": "png",
        "dpi": 300,
        "automata_graph_max_edges": 30
    },
    "reporting": {
        "primary_metric": "f1_score",
        "original_scenario": "original",
        "baseline_task_types": [
            "deep_learning_robustness",
            "automata_robustness"
        ],
        "pool_prediction_curves_across_repeated_runs": true,
        "automata_curve_score": "score_minus_calibrated_threshold",
        "generate_transition_figures": true,
        "generate_parameter_heatmaps": true,
        "generate_transition_density_heatmaps": true,
        "transition_density_definition": "observed_directed_transitions_divided_by_state_count_squared",
        "statistical_analysis": {
            "method": "paired_wilcoxon",
            "multiple_comparison_correction": "holm_bonferroni",
            "metric": "f1_score",
            "alpha": 0.05,
            "compared_models": ["lstm", "gru", "cnn1d"],
            "scenario": "original"
        }
    }
}